# Build output and stray binaries. Nothing in this tree compiles — the
# implementation is Python — so this is only here so that a scratch file cannot be
# committed by accident.
/bin/
/dist/
*.exe

# Bytecode, which is what running a checkout leaves behind instead of a build
# directory.
__pycache__/
*.pyc

# Personal agent scaffolding, not part of the project
.freebuff/

# Local environment. Only .env.example belongs in git — a real .env is where
# tokens and share keys end up, and a committed token is a leaked token.
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
.idea/
.vscode/
