# Copy to .env to change the default compose profile for the devnet:
#
#   cp .env.example .env
#
# Nothing here is secret. Bothy's devnet needs no keys of its own — the share
# key in docker-compose.yml is a well-known "dev-share-key" on purpose, so a
# fresh clone runs with no setup. Do not add tokens to .env; .env is ignored by
# git, but keeping credentials out of the repository directory entirely is the
# habit that survives a mistake.
#
#   mock      -> ships a fake engine, so the whole stack runs with no GPU
#   real      -> runs the real ollama/ollama image (needs a GPU to be useful)
#   mismatch  -> adds a second host with DIFFERENT weights, so you can watch the
#                client refuse it. Use together with mock:
#                COMPOSE_PROFILES=mock,mismatch docker compose up
#
# `make devnet`, `make real` and `make mismatch` set the profile for you and do
# not need this file at all.
COMPOSE_PROFILES=mock
